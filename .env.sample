# ==========================================
# Giftify Backend Environment Variables
# ==========================================
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.sample .env
# ==========================================

# -------- Auth0 설정 --------
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.giftify.com

# -------- PostgreSQL 설정 (docker-compose용) --------
POSTGRES_DB=giftify_db
POSTGRES_USER=giftify
POSTGRES_PASSWORD=your-secure-password

# -------- Spring Datasource 설정 (IDE 로컬 실행용) --------
# docker-compose 사용 시: jdbc:postgresql://localhost:5432/giftify_db
# 외부 DB 사용 시: 해당 DB URL로 변경
DB_URL=jdbc:postgresql://localhost:5432/giftify_db
DB_USERNAME=giftify
DB_PASSWORD=your-secure-password

# -------- Toss Payments 설정 --------
# 테스트 키: https://developers.tosspayments.com/sandbox 에서 발급
# 운영 키: Toss Payments 콘솔에서 발급
TOSSPAYMENTS_SECRET_KEY=test_sk_xxxxxxxx
#TOSSPAYMENTS_WEBHOOK_SECRET_KEY=whsk_xxxxxxxx
# TOSSPAYMENTS_API_BASE_URL=https://api.tosspayments.com  # 기본값 사용 시 생략 가능

# -------- Grafana 설정 (docker-compose 모니터링용) --------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password

#  -------- Crypto (민감 정보 암호화) --------
PAYMENT_ENCRYPTION_PASSWORD=
PAYMENT_ENCRYPTION_SALT=

#  -------- Redis  --------
REDIS_PASSWORD=

# -------- Kafka (Redpanda)  --------
KAFKA_BOOTSTRAP_SERVERS=
