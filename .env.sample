# -------- Auth0 설정 --------
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# -------- PostgreSQL 설정 (docker-compose용) --------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# -------- Spring Datasource 설정 (IDE 로컬 실행용) --------
# docker-compose 사용 시: jdbc:postgresql://localhost:5432/giftify_db
# 외부 DB 사용 시: 해당 DB URL로 변경
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# -------- Toss Payments 설정 --------
# 테스트 키: https://developers.tosspayments.com/sandbox 에서 발급
# 운영 키: Toss Payments 콘솔에서 발급
TOSSPAYMENTS_SECRET_KEY=
TOSSPAYMENTS_CLIENT_KEY=
TOSSPAYMENTS_WEBHOOK_SECRET_KEY=
# TOSSPAYMENTS_API_BASE_URL=https://api.tosspayments.com  # 기본값 사용 시 생략 가능

# -------- Grafana 설정 (docker-compose 모니터링용) --------
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
