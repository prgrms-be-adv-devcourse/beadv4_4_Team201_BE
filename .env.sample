# ==========================================
# Giftify Backend Environment Variables
# ==========================================
# 이 파일을 복사하여 .env 파일을 생성하세요
# cp .env.sample .env
#
# [사용처]
# - docker-compose.yml: 로컬 개발 환경 (api-server + infra)
# - application-{env}.yml: Spring Boot가 ${VAR} 형식으로 참조
#
# [K8s 배포 시]
# docker-compose가 아닌 K8s Secret으로 주입
# Secret 키 목록은 docker-compose.yml의 environment 섹션 참조
# ==========================================

# ======================
#  1. Auth0 (인증)
# ======================
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=https://api.giftify.com
# AUTH0_SECRET=  # 세션/토큰 암호화 구현 시 활성화

# ======================
#  2. Database
# ======================
# -- docker-compose 전용 (PostgreSQL 컨테이너 초기화) --
POSTGRES_DB=giftify_db
POSTGRES_USER=giftify
POSTGRES_PASSWORD=your-secure-password

# -- Spring Datasource --
# docker-compose: jdbc:postgresql://postgres:5432/giftify_db (컨테이너 호스트명)
# K8s: jdbc:postgresql://postgres:5432/giftify_db (K8s Service DNS)
# IDE 로컬: jdbc:postgresql://localhost:5432/giftify_db
DB_URL=jdbc:postgresql://localhost:5432/giftify_db
DB_USERNAME=giftify
DB_PASSWORD=your-secure-password

# ======================
#  3. Redis
# ======================
# K8s 주의: K8s가 Service별 {NAME}_PORT 환경변수를 자동 주입 (e.g. REDIS_PORT=tcp://...)
# Spring의 ${REDIS_PORT:6379}와 충돌하므로, K8s에서는 반드시 명시적으로 설정
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ======================
#  4. Elasticsearch
# ======================
# ES는 HTTP REST API 통신 — 전체 URL(scheme + host + port) 필요
ES_URIS=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=your-es-password

# ======================
#  5. Kafka (Redpanda)
# ======================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ======================
#  6. Toss Payments (결제)
# ======================
# 테스트 키: https://developers.tosspayments.com/sandbox
TOSSPAYMENTS_SECRET_KEY=test_sk_xxxxxxxx
TOSSPAYMENTS_API_BASE_URL=https://api.tosspayments.com
TOSSPAYMENTS_TIMEOUT_CONNECT=5s
TOSSPAYMENTS_TIMEOUT_READ=30s
# TOSSPAYMENTS_WEBHOOK_SECRET_KEY=whsk_xxxxxxxx  # 웹훅 검증 구현 시 활성화

# ======================
#  7. Crypto (민감 정보 암호화)
# ======================
# 결제 정보 AES 암호화용. Salt는 Hex 인코딩, 16바이트 이상
PAYMENT_ENCRYPTION_PASSWORD=your-encryption-password
PAYMENT_ENCRYPTION_SALT=deadbeefcafebabe

# ======================
#  8. Grafana (docker-compose 모니터링용)
# ======================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password
