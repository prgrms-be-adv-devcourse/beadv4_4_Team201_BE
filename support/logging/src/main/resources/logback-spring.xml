<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %magenta([%thread]) %cyan(%-40.40logger{39}) : %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Profiles -->
    <springProfile name="local,dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
        <!-- Application specific logging -->
        <logger name="giftify" level="DEBUG" />
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="giftify" level="INFO" />
    </springProfile>

    <!-- Default (if no profile active) -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
