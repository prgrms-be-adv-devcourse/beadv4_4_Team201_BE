# 사용법:
#   cp secrets.yaml.template secrets.yaml
#   secrets.yaml의 <REPLACE> 부분을 실제 값으로 교체
#   kubectl apply -f secrets.yaml
#
# 주의: secrets.yaml은 절대 git에 커밋하지 말 것
apiVersion: v1
kind: Secret
metadata:
    name: api-server-secrets
    namespace: giftify
type: Opaque
stringData:
    DB_URL: "jdbc:postgresql://postgres:5432/giftify_db"
    DB_USERNAME: "giftify"
    DB_PASSWORD: "<REPLACE>"
    REDIS_HOST: "redis"
    REDIS_PORT: "6379"
    REDIS_PASSWORD: "<REPLACE>"
    AUTH0_DOMAIN: "<REPLACE>"
    AUTH0_CLIENT_ID: "<REPLACE>"
    AUTH0_CLIENT_SECRET: "<REPLACE>"
    AUTH0_AUDIENCE: "<REPLACE>"
    TOSSPAYMENTS_API_BASE_URL: "https://api.tosspayments.com"
    TOSSPAYMENTS_SECRET_KEY: "<REPLACE>"
    PAYMENT_ENCRYPTION_PASSWORD: "<REPLACE>"
    PAYMENT_ENCRYPTION_SALT: "<REPLACE>"
    S3_ACCESS_KEY: "<REPLACE>"
    S3_SECRET_KEY: "<REPLACE>"
    S3_ENDPOINT: "https://s3.ap-northeast-2.amazonaws.com"
    S3_IMAGE_BUCKET: "giftify-images"
    S3_LOG_BUCKET: "giftify-logs"
    S3_REGION: "ap-northeast-2"
    SPRING_PROFILES_ACTIVE: "prod"
---
apiVersion: v1
kind: Secret
metadata:
    name: postgres-secrets
    namespace: giftify
type: Opaque
stringData:
    POSTGRES_DB: "giftify_db"
    POSTGRES_USER: "giftify"
    POSTGRES_PASSWORD: "<REPLACE>"
---
apiVersion: v1
kind: Secret
metadata:
    name: redis-secrets
    namespace: giftify
type: Opaque
stringData:
    REDIS_PASSWORD: "<REPLACE>"
---
apiVersion: v1
kind: Secret
metadata:
    name: cloudflare-secrets
    namespace: giftify
type: Opaque
stringData:
    TUNNEL_TOKEN: "<REPLACE>"
---
apiVersion: v1
kind: Secret
metadata:
    name: minio-secrets
    namespace: giftify
type: Opaque
stringData:
    MINIO_ROOT_USER: "<REPLACE>"
    MINIO_ROOT_PASSWORD: "<REPLACE>"
